    "@fontsource/aileron": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "iron-session": "^9.0.1",
    "next": "16.4.3",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "zod": "^4.6.6"
