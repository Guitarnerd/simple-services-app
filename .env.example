# Local Postgres started with: npx prisma dev -d -n simple-services
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Only needed for `prisma migrate dev` against the local `prisma dev` database
# (its shadow database listens on the next port up).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# File storage. With no token, uploads are written to ./uploads on this machine.
BLOB_READ_WRITE_TOKEN=

# Secret used to encrypt the login session cookie (iron-session).
SESSION_SECRET=

# Public base URL, used to build links in emails.
APP_URL=http://localhost:3100

# Email (Resend). With no API key, emails are printed to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Your Church <services@yourchurch.org>"

# Asked for on /setup, the first page of a new site, so a stranger can't claim it.
SETUP_CODE=

# First admin account, created by: npm run db:seed
SEED_ORG_NAME="My Church"
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=

# Protects the daily reminder job at /api/cron/reminders (Vercel sends it as a
# bearer token). With no value, the job refuses to run.
CRON_SECRET=

# Only for `npm run db:import-pco`: a Planning Center Personal Access Token, from
# https://api.planningcenteronline.com/oauth/applications
PCO_APP_ID=
PCO_SECRET=
